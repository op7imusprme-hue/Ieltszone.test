{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@config/*": ["config/*"],
      "@api/*": ["src/api/*"],
      "@components/*": ["src/components/*"],
      "@data/*": ["src/data/*"],
      "@fixtures": ["src/fixtures/index.ts"],
      "@pages/*": ["src/pages/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": ["config", "src", "tests", "playwright.config.ts"]
}
